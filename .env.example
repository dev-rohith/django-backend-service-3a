SECRET_KEY=change-me

# Local development only. Never set this in a deployed environment: it disables the
# security settings in config/settings.py and serves uploaded media through Django.
DEBUG=True

# Everything below already has a working default for local development.
# Uncomment only if you need to override it.

# ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://user:password@localhost:5432/docstore

# Throttle counters live in the cache. Point this at redis:// in any deployment
# running more than one worker, or each worker keeps its own counter.
# CACHE_URL=redis://localhost:6379/0

# Set only when a proxy you control rewrites X-Forwarded-For / X-Forwarded-Proto.
# TRUST_PROXY_HEADERS=True

# LOGIN_THROTTLE_RATE=5/min
# REGISTER_THROTTLE_RATE=5/min
# QUERY_THROTTLE_RATE=60/min
# USER_THROTTLE_RATE=1000/hour
# ANON_THROTTLE_RATE=100/hour

# AI / LLM
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Streamlit UI — override if the Django backend runs on a different port or host
# BACKEND_URL=http://localhost:8000
